# Telegram Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Comma separated Telegram user IDs of bot super admins (full control)
SUPER_ADMINS=123456789,987654321

# SQLite database path
DATABASE_PATH=data/bot.db

# Default membership duration (e.g. 30d, 1m, 2w, 12h). 1m = 1 month
DEFAULT_DURATION=1m

# How often (seconds) to check for expired members
CHECK_INTERVAL=60

# Timezone for date display / parsing (IANA name)
TIMEZONE=Asia/Kolkata

# Reminder before expiry in hours (comma separated, e.g. 72,24,1). Empty = no reminders
REMINDER_HOURS=72,24,1

# Log level: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
