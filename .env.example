# Telegram Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Comma separated Telegram user IDs of bot super admins (full control)
SUPER_ADMINS=123456789,987654321

# SQLite database path
DATABASE_PATH=data/bot.db

# Default membership duration (e.g. 30d, 1m, 2w, 12h). 1m = 1 month
DEFAULT_DURATION=1m

# How often (seconds) to check for expired members
CHECK_INTERVAL=60

# Timezone for date display / parsing (IANA name)
TIMEZONE=Asia/Kolkata

# Reminder before expiry in hours (comma separated, e.g. 72,24,1). Empty = no reminders
REMINDER_HOURS=72,24,1

# Log level: DEBUG, INFO, WARNING
LOG_LEVEL=INFO

# ---------------------------------------------------------------- join prompt
# Ask the chat owner how long each new member may stay (per-chat override in /panel)
ASK_ON_JOIN=true
# Hours to wait for an answer before silently keeping the default duration
ASK_TIMEOUT_HOURS=24

# ---------------------------------------------------------------- maintenance
# Directory for rotating log files
LOG_DIR=logs
# Optional: chat/user ID that receives the daily database backup file
BACKUP_CHAT_ID=
# Hour (UTC, 0-23) for daily maintenance: log pruning + backup
BACKUP_HOUR_UTC=3
# DM super admins when an unhandled error occurs
NOTIFY_ADMINS_ON_ERROR=true
# Local hour (in TIMEZONE) at which opted-in chats receive the daily "expiring soon" digest
DIGEST_HOUR=9

# ---------------------------------------------------------------- protection
# Anti-spam for commands/buttons: allow THROTTLE_BURST actions, then min THROTTLE_RATE seconds between actions
THROTTLE_RATE=0.5
THROTTLE_BURST=5

# ---------------------------------------------------------------- runtime / ops
# Optional HTTP side-car with /healthz, /readyz and /metrics (Prometheus). Empty = disabled
HTTP_PORT=
HTTP_HOST=0.0.0.0
# Switch from long polling to webhook mode: public https base URL of this bot (needs HTTP_PORT, default 8080)
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
# Random secret Telegram must echo back on every webhook call (A-Z a-z 0-9 _ -)
WEBHOOK_SECRET=
# Emit JSON log lines (for Docker / Loki / CloudWatch) instead of human-readable text
LOG_JSON=false
# Discard updates that queued up while the bot was offline
DROP_PENDING_UPDATES=false
# Seconds to cache chat settings / admin checks in memory (0 = disable caching)
CACHE_TTL=120
